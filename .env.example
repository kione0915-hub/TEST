# =============================================================
# 한국투자증권 OpenAPI 설정
# 이 파일을 복사해서 `.env` 로 저장한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# `.env` 는 .gitignore 에 등록되어 있어 git 에 절대 올라가지 않습니다.
# =============================================================

# 거래 모드: paper(모의투자) / real(실전투자)
KIS_MODE=paper

# --- 모의투자 API 키 (KIS Developers에서 발급) ---
KIS_PAPER_APP_KEY=여기에_모의투자_APP_KEY
KIS_PAPER_APP_SECRET=여기에_모의투자_APP_SECRET
# 모의투자 계좌번호 (예: 50123456-01 이면 앞 8자리)
KIS_PAPER_ACCOUNT_NO=50123456
# 계좌상품코드 (계좌번호 뒤 2자리, 보통 01)
KIS_PAPER_ACCOUNT_PRODUCT_CD=01

# --- 실전투자 API 키 (실전 전환 시에만 입력) ---
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT_CD=01

# --- 매매 설정 ---
# 감시/매매 대상 종목코드 (쉼표 구분, 예: 삼성전자,SK하이닉스)
TRADE_SYMBOLS=005930,000660
# 매수 수량 결정 방식: qty(고정 수량) / amount(고정 금액) / percent(예수금 비율)
ORDER_SIZING=qty
# qty 방식: 종목당 1회 주문 수량
TRADE_ORDER_QTY=1
# amount 방식: 1회 매수 금액 (원)
ORDER_AMOUNT=100000
# percent 방식: 예수금의 몇 % 어치 매수
ORDER_PERCENT=10
# 매도 신호 시 보유 수량의 몇 % 매도 (100 = 전량)
SELL_PERCENT=100
# 손절: 수익률이 -X% 이하면 전량 매도 (0 = 사용 안 함)
STOP_LOSS_PCT=0
# 익절: 수익률이 +Y% 이상이면 전량 매도 (0 = 사용 안 함)
TAKE_PROFIT_PCT=0
# 매매 루프 주기 (초)
TRADE_INTERVAL_SEC=60
# true: 신호 발생 시 자동 주문 + 알림 / false: 알림만 (주문 안 함)
AUTO_ORDER=true

# --- 텔레그램 알림 (선택) ---
# README 의 안내대로 봇을 만들면 매수/매도 신호를 휴대폰으로 받을 수 있습니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
